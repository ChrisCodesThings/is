{
    "name": "@chriscodesthings/stub-repo",
    "version": "0.1.0",
    "description": "npm package template",
    "keywords": [
        "stub",
        "package",
        "template"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ChrisCodesThings/stub-repo.git"
    },
    "bugs": {
        "url": "https://github.com/ChrisCodesThings/stub-repo/issues"
    },
    "dependencies": {},
    "devDependencies": {
        "auto-changelog": "^2.4.0",
        "jest": "^29.7.0",
        "typescript": "^5.4.5"
    },
    "main": "index.js",
    "type": "module",
    "files": [
        "/index.js",
        "/index.d.ts",
        "/types.js",
        "/types.d.ts",
        "/CHANGELOG.md",
        "/README.md",
        "/LICENSE",
        "/src"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "gen-dts": "find . -type f -name '*.d.ts' -not -path './node_modules/*' -delete && tsc -d --emitDeclarationOnly --allowJs index.js",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest && npm run gen-dts",
        "version": "auto-changelog -p && git add CHANGELOG.md",
        "postversion": "git push && git push --tags"
    },
    "publishConfig": {
        "access": "public"
    },
    "author": {
        "name": "Chris Dabrowa",
        "email": "fanmail@chris.dabrowa.uk",
        "url": "http://chris.dabrowa.uk/code/js"
    },
    "contributors": [],
    "license": "MIT"
}